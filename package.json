{
  "name": "pi-tmux-task",
  "version": "0.2.2",
  "description": "A minimal tmux-based task manager for agents, with skills and notifications only.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi",
    "tmux",
    "background-tasks",
    "task-runner",
    "automation"
  ],
  "homepage": "https://github.com/ttttmr/pi-tmux-task#readme",
  "bugs": {
    "url": "https://github.com/ttttmr/pi-tmux-task/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttttmr/pi-tmux-task.git"
  },
  "license": "MIT",
  "files": [
    "README.md",
    "README_ZH.md",
    "LICENSE",
    "docs",
    "skills",
    "src"
  ],
  "type": "module",
  "scripts": {
    "check": "node --experimental-strip-types ./test/check.mjs",
    "check:pi-integration": "node --experimental-strip-types ./test/pi-late-start-integration.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^1.4.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
